# 复制为 .env 并按需填写
# OpenAI 兼容接口（DeepSeek / Qwen / Moonshot 都可在这里配 base_url）
OPENAI_API_KEY=sk-xxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 可选：Tesseract OCR 可执行文件路径（未加入系统 PATH 时填写，如
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe）
# TESSERACT_CMD=

# 可选：数据目录（SQLite 库 app.db 与日志 logs/ 所在位置），默认 <项目根>/.data
# HR_CV_DATA_DIR=

# 可选：日志级别（DEBUG / INFO / WARNING / ERROR），默认 INFO
# HR_CV_LOG_LEVEL=INFO

# 可选：推理力度（low / high / max）。留空 = 走 DeepSeek 默认（high）。
# low 可明显缩短「思考中」阶段耗时，但回答质量可能下降
# LLM_REASONING_EFFORT=